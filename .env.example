# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NEXT_TELEMETRY_DISABLED="1"

# PostgreSQL — في Railway استخدم مرجعاً: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:pass@host/database?sslmode=require"

# مفتاح تشغيل 32 بايت Base64 (توليد: openssl rand -base64 32)
# لا تغيّره بعد حفظ مزودات. Web و Worker يجب أن يستخدما القيمة نفسها.
CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# اختياري — تهيئة مرة واحدة لأول owner. دوّره بعد الاستخدام.
BOOTSTRAP_ADMIN_TOKEN="replace-with-a-long-random-token"

# حدود أمان AI Runtime
MAX_MODEL_STEPS_PER_RUN="8"
MAX_TOTAL_TOOL_CALLS_PER_RUN="12"
TOOL_APPROVAL_TTL_SECONDS="900"
RUN_CHECKPOINT_TTL_SECONDS="86400"

# Worker المستقل على Railway
AI_WORKER_ENABLED="true"
WORKER_CONCURRENCY="4"

# OpenTelemetry (المحتوى وprompts لا تُسجل)
AI_OTEL_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# ميزات اختيارية معطّلة افتراضياً
AI_MEMORY_ENABLED="false"
AI_RAG_ENABLED="false"
AI_WORKFLOWS_ENABLED="false"
AI_TOOLS_ENABLED="true"

# اختبار
TEST_DATABASE_URL=""
E2E_BASE_URL=""
E2E_PROVIDER_KIND=""
E2E_PROVIDER_KEY=""
E2E_PROVIDER_BASE_URL=""
E2E_PROVIDER_MODEL=""

# مهلة migration لمسافات بعيدة
MIGRATION_TIMEOUT_MS="45000"

# موصل YouTube اختياري
YOUTUBE_TRANSCRIPT_API_URL=""
YOUTUBE_TRANSCRIPT_API_KEY=""
